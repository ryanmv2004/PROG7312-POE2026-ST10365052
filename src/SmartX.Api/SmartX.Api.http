@baseUrl = http://localhost:5080

@timestampUtc = REPLACE_WITH_CURRENT_UTC_TIME

@sensorId = 00000000-0000-0000-0000-000000000000

GET {{baseUrl}}/api/health

### Register a temperature sensor
POST {{baseUrl}}/api/sensors
Content-Type: application/json
X-SmartX-Client: dashboard

{
  "deviceIdentifier": "MANUAL-TEMP-001",
  "location": "Room A",
  "category": "Environmental",
  "readingKind": "Temperature",
  "minValue": 10,
  "maxValue": 40,
  "disconnectAfterSeconds": 15
}

### List all registered sensors with health status
GET {{baseUrl}}/api/sensors

### Submit float telemetry data
POST {{baseUrl}}/api/sensors/{{sensorId}}/telemetry/temperature
Content-Type: application/json
X-SmartX-Client: dashboard

{
  "sensorId": "{{sensorId}}",
  "timestampUtc": "{{timestampUtc}}",
  "value": 24.5
}

### Retrieve typed readings
GET {{baseUrl}}/api/sensors/{{sensorId}}/telemetry/temperature

### Wrongly typed payload
POST {{baseUrl}}/api/sensors/{{sensorId}}/telemetry/temperature
Content-Type: application/json
X-SmartX-Client: dashboard

{
  "sensorId": "{{sensorId}}",
  "timestampUtc": "{{timestampUtc}}",
  "value": "this is not a float"
}
